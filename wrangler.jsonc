// Configuracion para Cloudflare (Workers con archivos estaticos).
// Cloudflare corre `npm run build` y luego `npx wrangler deploy`;
// este archivo le dice que sirva la carpeta dist tal cual.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huellas-a-casa",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
